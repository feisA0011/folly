## 📐 CSS Custom Properties

```css
:root {
  /* === BRAND COLOURS === */
  --color-bg-light:       #F0F0EE;
  --color-neutral-border: #DBDBDB;
  --color-text-primary:   #4A5262;
  --color-accent-muted:   #7A899B;
  --color-primary:        #506383;
  --color-primary-dark:   #2E4160;
  --color-surface:        #FFFFFF;
  --color-frame-dark:     #333333;

  /* === TYPOGRAPHY === */
  --font-display:        'Space Grotesk', 'Inter', sans-serif;
  --font-body:           'Inter', sans-serif;
  --font-weight-light:   300;
  --font-weight-regular: 400;
  --font-weight-medium:  500;
  --font-weight-semibold: 600;
  --font-weight-bold:    700;

  /* === SEMANTIC TOKENS === */
  --color-heading:       var(--color-primary-dark);
  --color-body:          var(--color-text-primary);
  --color-caption:       var(--color-accent-muted);
  --color-link:          var(--color-primary);
  --color-link-hover:    var(--color-primary-dark);
  --color-bg-page:       var(--color-bg-light);
  --color-bg-card:       var(--color-surface);
  --color-bg-hero:       var(--color-primary-dark);
  --color-divider:       var(--color-neutral-border);
}
```

